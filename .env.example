# =============================================================================
# pnt-api 환경설정 템플릿
#
# 사용법:  cp .env.example .env  후 changeme 항목을 채운다.
#          .env 는 .gitignore 로 제외되며 절대 커밋하지 않는다.
#
# changeme 로 표시된 항목은 자격증명이다. 나머지는 운영값을 그대로 두었으니
# 환경이 다르면 수정한다(특히 MINIO_ENDPOINT).
# =============================================================================

PNT_USER_ID=changeme
PNT_USER_PASSWORD=changeme
PNT_ACCESS_TOKEN=changeme

# MongoDB
MONGO_URI=changeme
MONGO_DB=CHAI
MONGO_COLLECTION=ProductsList
MONGO_DIVISION_COLLECTION=DivisionList

# main.py에서 조회 시 사용하는 컬렉션명
MONGO_DIVISIONLIST_COLLECTION=DivisionList
MONGO_ANNOTATIONLABEL_COLLECTION=AnnotationLabel
PNT_PATH_IF14=/api/v1/chai/device/store

MINIO_ENDPOINT=10.0.0.1:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_BUCKET=chaiimage
MINIO_BASE_PREFIX=NewAnnotation

QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_LORA_ADAPTER=
QWEN_LORA_MERGE=false

QWEN_TORCH_DTYPE=bfloat16
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PIPELINE_ANNOTATION_GPUS=0

HF_TOKEN=changeme
HUGGINGFACE_HUB_TOKEN=changeme

SEED_DETECTOR=sam3
SAM3_HAND_PROMPT=hand
SAM3_OBJECT_PROMPT="packaged retail product"
SAM3_SCORE_THRESHOLD=0.30

CVAT_USERNAME=changeme
CVAT_PASSWORD=changeme

# 디렉터리명이 바뀌어도 기존 named volume(0_pnt_model-cache 등)을 계속 사용
COMPOSE_PROJECT_NAME=0_pnt
